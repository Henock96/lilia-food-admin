<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Config Release = distribution (TestFlight / App Store) : APNs de
	     PRODUCTION (ADM-15, audit du 13/10/2026, aligné sur lilia-app et
	     lilia_food_delivery). Un token du sandbox est rejeté par APNs
	     production, et inversement : un build distribué avec `development`
	     ne recevait aucune alerte « nouvelle commande ».
	     Debug et Profile gardent `development` (Runner.entitlements) pour les
	     essais sur appareil signés avec un profil de développement.
	     ⚠️ Cette valeur ne prouve PAS que le push fonctionne : la clé APNs du
	     projet Firebase doit aussi être valide (Team ID 4R7BCB3ZSZ). -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
